{
  "version": "1.0",
  "description": "Standard field taxonomy for universal log ingestion pipeline",
  "last_updated": "2025-10-14",
  
  "standard_fields": {
    "timestamp": {
      "description": "Event timestamp (ISO 8601 format preferred)",
      "type": "datetime",
      "required": true,
      "format": "ISO 8601 or custom",
      "aliases": [
        "time",
        "date",
        "datetime",
        "eventTime",
        "event_time",
        "@timestamp",
        "log_time",
        "timestamp_utc",
        "created_at"
      ],
      "examples": [
        "2025-10-14T13:15:37Z",
        "2025-10-14 13:15:37",
        "Oct 14 13:15:37",
        "1697289337"
      ]
    },
    
    "source_ip": {
      "description": "Source IP address (IPv4 or IPv6)",
      "type": "ip",
      "required": false,
      "validation": "IPv4 or IPv6 format",
      "aliases": [
        "src_ip",
        "srcIP",
        "sourceIP",
        "source_addr",
        "src_address",
        "clientIP",
        "client_ip",
        "origin_ip",
        "from_ip"
      ],
      "examples": [
        "192.168.0.62",
        "10.0.0.1",
        "2001:0db8:85a3:0000:0000:8a2e:0370:7334"
      ]
    },
    
    "dest_ip": {
      "description": "Destination IP address (IPv4 or IPv6)",
      "type": "ip",
      "required": false,
      "validation": "IPv4 or IPv6 format",
      "aliases": [
        "dst_ip",
        "dstIP",
        "destIP",
        "destination_ip",
        "dest_addr",
        "dst_address",
        "serverIP",
        "server_ip",
        "target_ip",
        "to_ip"
      ],
      "examples": [
        "162.159.61.3",
        "8.8.8.8",
        "2606:4700::6810:85e5"
      ]
    },
    
    "src_port": {
      "description": "Source port number",
      "type": "integer",
      "required": false,
      "validation": "1-65535",
      "aliases": [
        "source_port",
        "srcPort",
        "sourcePort",
        "client_port",
        "from_port"
      ],
      "examples": [
        "48367",
        "443",
        "22"
      ]
    },
    
    "dst_port": {
      "description": "Destination port number",
      "type": "integer",
      "required": false,
      "validation": "1-65535",
      "aliases": [
        "dest_port",
        "destination_port",
        "dstPort",
        "destPort",
        "server_port",
        "target_port",
        "to_port"
      ],
      "examples": [
        "443",
        "80",
        "22",
        "3389"
      ]
    },
    
    "protocol": {
      "description": "Network protocol",
      "type": "string",
      "required": false,
      "validation": "TCP, UDP, ICMP, etc.",
      "aliases": [
        "proto",
        "network_protocol",
        "ip_protocol",
        "protocol_name"
      ],
      "examples": [
        "TCP",
        "UDP",
        "ICMP",
        "HTTP",
        "HTTPS"
      ]
    },
    
    "severity": {
      "description": "Log severity level",
      "type": "string",
      "required": false,
      "validation": "Standard severity levels",
      "aliases": [
        "level",
        "priority",
        "logLevel",
        "log_level",
        "criticality",
        "severity_level"
      ],
      "values": [
        "CRITICAL",
        "ERROR",
        "WARNING",
        "INFO",
        "DEBUG",
        "TRACE"
      ],
      "examples": [
        "ERROR",
        "WARNING",
        "INFO"
      ]
    },
    
    "action": {
      "description": "Action taken (firewall/security logs)",
      "type": "string",
      "required": false,
      "aliases": [
        "event_action",
        "decision",
        "verdict",
        "disposition",
        "outcome"
      ],
      "values": [
        "ALLOW",
        "ALLOWED",
        "DENY",
        "DENIED",
        "DROP",
        "BLOCK",
        "REJECT",
        "ACCEPT"
      ],
      "examples": [
        "ALLOWED",
        "DENIED",
        "DROP"
      ]
    },
    
    "log": {
      "description": "Log message or event description",
      "type": "text",
      "required": true,
      "aliases": [
        "message",
        "msg",
        "event",
        "description",
        "event_description",
        "log_message",
        "text",
        "details"
      ],
      "examples": [
        "Connection established from 192.168.0.62 to 162.159.61.3",
        "User login successful",
        "File access denied"
      ]
    },
    
    "user": {
      "description": "Username or user identifier",
      "type": "string",
      "required": false,
      "aliases": [
        "username",
        "user_name",
        "account",
        "userId",
        "user_id",
        "principal",
        "subject"
      ],
      "examples": [
        "admin",
        "john.doe",
        "user@example.com"
      ]
    },
    
    "source_system": {
      "description": "Source system or hostname",
      "type": "string",
      "required": false,
      "aliases": [
        "hostname",
        "host",
        "computer",
        "device",
        "system",
        "source_host",
        "origin"
      ],
      "examples": [
        "firewall-01",
        "web-server",
        "192.168.0.1"
      ]
    },
    
    "app_name": {
      "description": "Application or service name",
      "type": "string",
      "required": false,
      "aliases": [
        "application",
        "service",
        "process",
        "program",
        "app",
        "service_name"
      ],
      "examples": [
        "sshd",
        "nginx",
        "firewall"
      ]
    },
    
    "event_id": {
      "description": "Unique event identifier",
      "type": "string",
      "required": false,
      "aliases": [
        "eventID",
        "event_code",
        "id",
        "log_id",
        "event_number"
      ],
      "examples": [
        "4624",
        "EVT-12345",
        "1000"
      ]
    },
    
    "category": {
      "description": "Event category or classification",
      "type": "string",
      "required": false,
      "aliases": [
        "event_category",
        "log_category",
        "type",
        "event_type",
        "classification"
      ],
      "values": [
        "AUTHENTICATION",
        "AUTHORIZATION",
        "NETWORK",
        "FIREWALL",
        "SYSTEM",
        "APPLICATION",
        "SECURITY"
      ],
      "examples": [
        "FIREWALL",
        "AUTHENTICATION",
        "NETWORK"
      ]
    },
    
    "bytes_sent": {
      "description": "Number of bytes sent",
      "type": "integer",
      "required": false,
      "aliases": [
        "sent_bytes",
        "tx_bytes",
        "upload",
        "outbound_bytes"
      ],
      "examples": [
        "1024",
        "524288"
      ]
    },
    
    "bytes_received": {
      "description": "Number of bytes received",
      "type": "integer",
      "required": false,
      "aliases": [
        "received_bytes",
        "rx_bytes",
        "download",
        "inbound_bytes"
      ],
      "examples": [
        "2048",
        "1048576"
      ]
    },
    
    "duration": {
      "description": "Event duration in seconds",
      "type": "float",
      "required": false,
      "aliases": [
        "elapsed_time",
        "time_taken",
        "response_time",
        "session_duration"
      ],
      "examples": [
        "0.123",
        "45.678"
      ]
    },
    
    "geo_location": {
      "description": "Geographic location",
      "type": "string",
      "required": false,
      "aliases": [
        "location",
        "country",
        "city",
        "region",
        "geo"
      ],
      "examples": [
        "US",
        "New York, USA",
        "40.7128,-74.0060"
      ]
    },
    
    "url": {
      "description": "URL or URI",
      "type": "string",
      "required": false,
      "aliases": [
        "uri",
        "path",
        "endpoint",
        "request_uri"
      ],
      "examples": [
        "https://example.com/api/users",
        "/admin/login",
        "http://192.168.0.1:8080/status"
      ]
    },
    
    "http_method": {
      "description": "HTTP request method",
      "type": "string",
      "required": false,
      "aliases": [
        "method",
        "request_method",
        "verb"
      ],
      "values": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "PATCH",
        "HEAD",
        "OPTIONS"
      ],
      "examples": [
        "GET",
        "POST"
      ]
    },
    
    "status_code": {
      "description": "HTTP status code or response code",
      "type": "integer",
      "required": false,
      "aliases": [
        "http_status",
        "response_code",
        "code",
        "return_code"
      ],
      "examples": [
        "200",
        "404",
        "500"
      ]
    },
    
    "source_type": {
      "description": "Type of log source (added by parser)",
      "type": "string",
      "required": false,
      "aliases": [
        "log_source",
        "source_format",
        "format"
      ],
      "values": [
        "csv",
        "json",
        "syslog",
        "key_value",
        "cef",
        "raw"
      ],
      "examples": [
        "csv",
        "json",
        "syslog"
      ]
    },
    
    "raw_log": {
      "description": "Original unparsed log line (for debugging)",
      "type": "text",
      "required": false,
      "aliases": [
        "original_log",
        "raw_message",
        "raw"
      ],
      "examples": [
        "2025-10-13 13:15:37,Firewall,Allowed,192.168.0.62,162.159.61.3,443,TCP"
      ]
    },
    
    "parser_id": {
      "description": "ID of parser used (added automatically)",
      "type": "string",
      "required": false,
      "examples": [
        "sophos-fw-csv-v1",
        "checkpoint-fw-abc123"
      ]
    },
    
    "parser_name": {
      "description": "Name of parser used (added automatically)",
      "type": "string",
      "required": false,
      "examples": [
        "Sophos Firewall CSV",
        "Checkpoint Firewall"
      ]
    },
    
    "ingested_at": {
      "description": "Timestamp when log was ingested (added automatically)",
      "type": "datetime",
      "required": false,
      "format": "ISO 8601",
      "examples": [
        "2025-10-14T13:15:37Z"
      ]
    }
  },
  
  "field_groups": {
    "network": [
      "source_ip",
      "dest_ip",
      "src_port",
      "dst_port",
      "protocol",
      "bytes_sent",
      "bytes_received"
    ],
    "authentication": [
      "user",
      "action",
      "source_ip",
      "source_system",
      "status_code"
    ],
    "firewall": [
      "source_ip",
      "dest_ip",
      "src_port",
      "dst_port",
      "protocol",
      "action",
      "severity"
    ],
    "web": [
      "source_ip",
      "url",
      "http_method",
      "status_code",
      "bytes_sent",
      "bytes_received",
      "duration"
    ],
    "system": [
      "source_system",
      "app_name",
      "severity",
      "user",
      "event_id"
    ]
  },
  
  "mapping_rules": {
    "case_insensitive": true,
    "underscore_equivalent_to_space": true,
    "partial_match_allowed": true,
    "priority": [
      "exact_match",
      "alias_match",
      "contains_match"
    ]
  },
  
  "validation_rules": {
    "ip": {
      "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$|^([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}$",
      "description": "IPv4 or IPv6 address"
    },
    "port": {
      "min": 1,
      "max": 65535,
      "description": "Valid port number"
    },
    "timestamp": {
      "formats": [
        "ISO 8601",
        "%Y-%m-%d %H:%M:%S",
        "%Y-%m-%dT%H:%M:%S",
        "%Y-%m-%dT%H:%M:%SZ",
        "%b %d %H:%M:%S",
        "epoch",
        "epoch_ms"
      ],
      "description": "Valid timestamp format"
    }
  },
  
  "notes": {
    "usage": "This file defines the standard field taxonomy for the universal log ingestion pipeline. All parsers should map detected fields to these standard fields for consistency.",
    "extending": "To add custom fields, add them to the standard_fields object with proper description, type, and aliases.",
    "backward_compatibility": "Parsers created before this taxonomy should continue to work. This file provides a reference for best practices."
  }
}
