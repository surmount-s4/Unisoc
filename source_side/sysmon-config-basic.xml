<?xml version="1.0" encoding="UTF-8"?>
<!--
Basic Sysmon Configuration for Custom Security Loggers
======================================================
This configuration focuses on the essential events needed by the Custom Security Loggers
while maintaining good performance and reasonable log volume.

Target Events:
- Process Creation (Event ID 1) - for detecting LOLBins, suspicious process chains
- File Creation (Event ID 11) - for monitoring dropped files  
- Registry Events (Event ID 12,13,14) - for persistence detection
- Network Connections (Event ID 3) - for C2 communication detection
- Process Termination (Event ID 5) - for process lifecycle tracking

Author: Custom Security Loggers Project
Version: 1.0
Compatible with: Sysmon v13+
-->

<Sysmon schemaversion="4.82">
    <!-- Capture all hashes for better forensics -->
    <HashAlgorithms>md5,sha256,IMPHASH</HashAlgorithms>
    
    <!-- Check for signature revocation -->
    <CheckRevocation>true</CheckRevocation>
    
    <!-- Event filtering -->
    <EventFiltering>
        
        <!--SYSMON EVENT ID 1 : PROCESS CREATION-->
        <RuleGroup name="" groupRelation="or">
            <ProcessCreate onmatch="exclude">
                <!-- Exclude common system processes to reduce noise -->
                <Image condition="is">C:\Windows\System32\smss.exe</Image>
                <Image condition="is">C:\Windows\System32\csrss.exe</Image>
                <Image condition="is">C:\Windows\System32\wininit.exe</Image>
                <Image condition="is">C:\Windows\System32\winlogon.exe</Image>
                <Image condition="is">C:\Windows\System32\services.exe</Image>
                <Image condition="is">C:\Windows\System32\lsass.exe</Image>
                <Image condition="is">C:\Windows\System32\lsm.exe</Image>
                <Image condition="is">C:\Windows\System32\svchost.exe</Image>
                <Image condition="is">C:\Windows\System32\spoolsv.exe</Image>
                <Image condition="is">C:\Windows\System32\dwm.exe</Image>
                <Image condition="is">C:\Windows\System32\explorer.exe</Image>
                
                <!-- Exclude Windows Defender -->
                <Image condition="begin">C:\ProgramData\Microsoft\Windows Defender\</Image>
                <Image condition="begin">C:\Program Files\Windows Defender\</Image>
                
                <!-- Exclude common browsers when they're not suspicious -->
                <ParentImage condition="is">C:\Program Files\Google\Chrome\Application\chrome.exe</ParentImage>
                <ParentImage condition="is">C:\Program Files (x86)\Google\Chrome\Application\chrome.exe</ParentImage>
                <ParentImage condition="is">C:\Program Files\Mozilla Firefox\firefox.exe</ParentImage>
                <ParentImage condition="is">C:\Program Files (x86)\Mozilla Firefox\firefox.exe</ParentImage>
            </ProcessCreate>
        </RuleGroup>
        
        <!--SYSMON EVENT ID 3 : NETWORK CONNECTION-->
        <RuleGroup name="" groupRelation="or">
            <NetworkConnect onmatch="exclude">
                <!-- Exclude local connections -->
                <DestinationIp condition="is">127.0.0.1</DestinationIp>
                <DestinationIp condition="is">::1</DestinationIp>
                
                <!-- Exclude private networks for most processes -->
                <DestinationIp condition="begin">10.</DestinationIp>
                <DestinationIp condition="begin">192.168.</DestinationIp>
                <DestinationIp condition="begin">172.16.</DestinationIp>
                <DestinationIp condition="begin">172.17.</DestinationIp>
                <DestinationIp condition="begin">172.18.</DestinationIp>
                <DestinationIp condition="begin">172.19.</DestinationIp>
                <DestinationIp condition="begin">172.20.</DestinationIp>
                <DestinationIp condition="begin">172.21.</DestinationIp>
                <DestinationIp condition="begin">172.22.</DestinationIp>
                <DestinationIp condition="begin">172.23.</DestinationIp>
                <DestinationIp condition="begin">172.24.</DestinationIp>
                <DestinationIp condition="begin">172.25.</DestinationIp>
                <DestinationIp condition="begin">172.26.</DestinationIp>
                <DestinationIp condition="begin">172.27.</DestinationIp>
                <DestinationIp condition="begin">172.28.</DestinationIp>
                <DestinationIp condition="begin">172.29.</DestinationIp>
                <DestinationIp condition="begin">172.30.</DestinationIp>
                <DestinationIp condition="begin">172.31.</DestinationIp>
                
                <!-- Exclude system processes -->
                <Image condition="is">C:\Windows\System32\svchost.exe</Image>
                <Image condition="is">C:\Windows\System32\spoolsv.exe</Image>
                
                <!-- Exclude common update services -->
                <Image condition="end">GoogleUpdate.exe</Image>
                <Image condition="end">MicrosoftEdgeUpdate.exe</Image>
            </NetworkConnect>
        </RuleGroup>
        
        <!--SYSMON EVENT ID 5 : PROCESS TERMINATION-->
        <RuleGroup name="" groupRelation="or">
            <ProcessTerminate onmatch="exclude">
                <!-- Monitor all process terminations for suspicious behavior -->
                <!-- Only exclude extremely noisy system processes -->
                <Image condition="is">C:\Windows\System32\smss.exe</Image>
            </ProcessTerminate>
        </RuleGroup>
        
        <!--SYSMON EVENT ID 11 : FILE CREATE-->
        <RuleGroup name="" groupRelation="or">
            <FileCreate onmatch="exclude">
                <!-- Exclude temp files and logs -->
                <TargetFilename condition="contains">\AppData\Local\Temp\</TargetFilename>
                <TargetFilename condition="contains">\Windows\Temp\</TargetFilename>
                <TargetFilename condition="end">.tmp</TargetFilename>
                <TargetFilename condition="end">.log</TargetFilename>
                <TargetFilename condition="end">.bak</TargetFilename>
                
                <!-- Exclude browser cache -->
                <TargetFilename condition="contains">\Google\Chrome\User Data\</TargetFilename>
                <TargetFilename condition="contains">\Mozilla\Firefox\Profiles\</TargetFilename>
                <TargetFilename condition="contains">\Microsoft\Edge\User Data\</TargetFilename>
                
                <!-- Exclude Windows Update files -->
                <TargetFilename condition="begin">C:\Windows\SoftwareDistribution\</TargetFilename>
                <TargetFilename condition="begin">C:\Windows\WinSxS\</TargetFilename>
                
                <!-- Focus on executable files and scripts in suspicious locations -->
                <TargetFilename condition="begin">C:\Windows\System32\</TargetFilename>
                <TargetFilename condition="begin">C:\Windows\SysWOW64\</TargetFilename>
            </FileCreate>
        </RuleGroup>
        
        <!--SYSMON EVENT ID 12 : REGISTRY CREATE/DELETE-->
        <RuleGroup name="" groupRelation="or">
            <RegistryEvent onmatch="include">
                <!-- Monitor persistence locations -->
                <TargetObject condition="contains">CurrentVersion\Run</TargetObject>
                <TargetObject condition="contains">CurrentVersion\RunOnce</TargetObject>
                <TargetObject condition="contains">CurrentVersion\RunServices</TargetObject>
                <TargetObject condition="contains">CurrentVersion\RunServicesOnce</TargetObject>
                <TargetObject condition="contains">\Services\</TargetObject>
                <TargetObject condition="contains">\CurrentVersion\Windows\Load</TargetObject>
                <TargetObject condition="contains">\CurrentVersion\Windows\Run</TargetObject>
                <TargetObject condition="contains">\CurrentVersion\Winlogon\</TargetObject>
                
                <!-- Monitor security-related registry keys -->
                <TargetObject condition="contains">\Policies\Explorer\Run</TargetObject>
                <TargetObject condition="contains">\Group Policy\Scripts</TargetObject>
                
                <!-- Monitor scheduled tasks -->
                <TargetObject condition="contains">\Schedule\TaskCache\Tree\</TargetObject>
            </RegistryEvent>
        </RuleGroup>
        
        <!--SYSMON EVENT ID 13 : REGISTRY VALUE SET-->
        <RuleGroup name="" groupRelation="or">
            <RegistryEvent onmatch="include">
                <!-- Monitor persistence locations -->
                <TargetObject condition="contains">CurrentVersion\Run</TargetObject>
                <TargetObject condition="contains">CurrentVersion\RunOnce</TargetObject>
                <TargetObject condition="contains">CurrentVersion\RunServices</TargetObject>
                <TargetObject condition="contains">CurrentVersion\RunServicesOnce</TargetObject>
                <TargetObject condition="contains">\Services\</TargetObject>
                <TargetObject condition="contains">\CurrentVersion\Windows\Load</TargetObject>
                <TargetObject condition="contains">\CurrentVersion\Windows\Run</TargetObject>
                <TargetObject condition="contains">\CurrentVersion\Winlogon\</TargetObject>
                
                <!-- Monitor security bypass attempts -->
                <TargetObject condition="contains">\Policies\System\EnableLUA</TargetObject>
                <TargetObject condition="contains">\Policies\System\ConsentPromptBehaviorAdmin</TargetObject>
                <TargetObject condition="contains">\Windows Defender\</TargetObject>
                
                <!-- Monitor Office security settings -->
                <TargetObject condition="contains">\Security\Trusted Documents\</TargetObject>
                <TargetObject condition="contains">\Security\VBAWarnings</TargetObject>
                <TargetObject condition="contains">\Security\ProtectedView\</TargetObject>
            </RegistryEvent>
        </RuleGroup>
        
        <!--SYSMON EVENT ID 14 : REGISTRY RENAME-->
        <RuleGroup name="" groupRelation="or">
            <RegistryEvent onmatch="include">
                <!-- Monitor persistence locations -->
                <TargetObject condition="contains">CurrentVersion\Run</TargetObject>
                <TargetObject condition="contains">CurrentVersion\RunOnce</TargetObject>
                <TargetObject condition="contains">\Services\</TargetObject>
            </RegistryEvent>
        </RuleGroup>
        
    </EventFiltering>
</Sysmon>
