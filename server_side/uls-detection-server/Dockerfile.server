FROM cgr.dev/chainguard/go:latest AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/uls-server ./cmd/server

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder /out/uls-server /usr/local/bin/uls-server

ENTRYPOINT ["uls-server"]
