# Copy to setup-postgres-linux.env and source it before running the script.

# Optional Docker mode (if PostgreSQL runs in a container)
# DOCKER_CONTAINER=uls-timescaledb

# Admin connection (must be a superuser or role with create role/db privileges)
DB_HOST=localhost
DB_PORT=5432
ADMIN_DB=postgres
ADMIN_USER=postgres
ADMIN_PASSWORD=postgres

# Application role/database created by the script
APP_DB=uls_detection
APP_USER=uls_user
APP_PASSWORD=ChangeThisPassword123!

# Optional explicit schema SQL path
# SCHEMA_FILE=/opt/uls-detection-server/init-scripts/02-init-uls-schema.sql
