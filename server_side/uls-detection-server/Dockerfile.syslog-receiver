FROM golang:1.21-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/uls-syslog-receiver ./cmd/syslog-receiver

FROM alpine:3.20

RUN adduser -D -H -u 10001 appuser

COPY --from=builder /out/uls-syslog-receiver /usr/local/bin/uls-syslog-receiver

USER appuser

ENTRYPOINT ["uls-syslog-receiver"]
