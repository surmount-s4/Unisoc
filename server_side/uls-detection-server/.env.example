# ------------------------------------------------------------
# ULS Detection Server - Environment Configuration Template
# Copy this file to .env and edit values for your environment.
# ------------------------------------------------------------

# =========================
# PostgreSQL / TimescaleDB
# =========================
# Used by docker-compose
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# Used by the Go server (cmd/server/main.go)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_PASS=admin
POSTGRES_DB=uls_detection

# ==========
# RabbitMQ
# ==========
# Used by docker-compose
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin

# Used by the Go server (cmd/server/main.go)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_PASS=admin
RABBITMQ_QUEUE=security_events
RABBITMQ_FW_QUEUE=firewall_events
RABBITMQ_SCADA_QUEUE=scada_logs

# Used by Go universal syslog receiver (cmd/syslog-receiver)
SYSLOG_BATCH_SIZE=50
SYSLOG_FLUSH_SEC=2

# =====================
# Ingest batch behavior
# =====================
BATCH_SIZE=100
BATCH_DELAY_MS=1000

# =============================
# LLM watcher (pass-1 enrichment)
# =============================
# Leave OLLAMA_URL empty to run in passthrough mode.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral-nemo:12b-instruct-2407-fp16
LLM_WINDOW_SECONDS=5
LLM_PASS_ENABLED=true

# ================================
# Correlation engine v2 scheduling
# ================================
CORRELATION_ENGINE_V2_ENABLED=true
CORR_WINDOW_MINUTES=10
CORR_TICK_SECONDS=60

# =======================================
# BART pre-classifier for Windows events
# =======================================
# In-process mode (recommended): local python runner with facebook/bart-large-mnli.
BART_INPROCESS=true
BART_MODEL_ID=facebook/bart-large-mnli
# Optional local model directory. If empty, runner downloads/caches from Hugging Face.
BART_MODEL_PATH=
# Python executable used to start in-process runner.
BART_PYTHON_BIN=python
# Relative or absolute path to the runner script.
BART_RUNNER_PATH=internal/correlationengine/bart_runner.py

# Optional HTTP fallback backend (used only when BART_INPROCESS=false,
# or when in-process startup fails and this URL is configured).
BART_SERVICE_URL=
BART_MODEL=
BART_TIMEOUT_SECONDS=15
BART_CONFIDENCE_THRESHOLD=0.30

# =====================================
# Correlator LLM (cross-source analysis)
# =====================================
# If CORR_LLM_URL is empty, server falls back to OLLAMA_URL.
CORR_LLM_URL=
CORR_LLM_MODEL=mistral-nemo:12b-instruct-2407-fp16
CORR_LLM_TIMEOUT_SECONDS=60

# ============================
# Internal SCADA HTTP endpoint
# ============================
SCADA_HTTP_PORT=5001
